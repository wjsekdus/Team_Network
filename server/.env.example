# 사용법: 이 파일을 같은 폴더에 .env 로 복사한 뒤 값을 채운다.  (copy server\.env.example server\.env)
# .env 는 .gitignore 에 포함되어 Git 에 올라가지 않는다. 실제 비밀번호를 이 예제 파일에 쓰지 말 것.

# 서버가 바인딩할 주소/포트. 0.0.0.0 이면 같은 Wi-Fi 의 휴대폰에서도 접속 가능.
PNT_SERVER_HOST=0.0.0.0
PNT_SERVER_PORT=8080

# PostgreSQL 연결 정보 (docs/development/SERVER_SETUP.md 참고)
PNT_DB_URL=jdbc:postgresql://localhost:5432/police_thief
PNT_DB_USER=police_thief
PNT_DB_PASSWORD=change_me

# PostgreSQL 이 없을 때 임시로 쓸 수 있는 H2 파일 DB (선택). 위 3줄 대신 아래를 사용.
# PNT_DB_URL=jdbc:h2:file:./build/devdb/police_thief;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
# PNT_DB_USER=sa
# PNT_DB_PASSWORD=

# true: 앱의 개발자 테스트 좌표(source=MOCK)를 허용. 개발/시연용 서버에서만 true.
PNT_ALLOW_MOCK_LOCATIONS=true

# 게스트 토큰 유효 기간(일)
PNT_TOKEN_TTL_DAYS=30
