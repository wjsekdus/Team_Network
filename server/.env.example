# =============================================================================
# 경찰과 도둑 서버 환경 변수 예제
# =============================================================================
# 사용법: 이 파일을 같은 폴더에 .env 로 복사한 뒤 값을 채운다.   (PowerShell: copy server\.env.example server\.env)
# - .env 는 .gitignore 에 포함되어 Git 에 올라가지 않는다. 실제 비밀번호를 이 예제 파일에 쓰지 말 것.
# - `gradlew.bat :server:run` 으로 실행할 때만 이 파일이 읽힌다. 이미 Windows 환경 변수가 있으면 그 값이 우선한다.
# - 형식: 한 줄에 이름=값. '#' 으로 시작하는 줄만 주석이다.
#   !! 값 뒤에 같은 줄로 '# 설명' 을 붙이지 말 것 (설명까지 값으로 읽힌다). 따옴표도 값에 그대로 포함된다.
# - '#' 로 막아 둔 줄은 "기본값을 쓴다"는 뜻이다. 바꾸고 싶은 줄만 '#' 을 지우고 값을 고친다.
# - 설명서: docs/development/RUN_GUIDE.md (실행), docs/development/GAME_CONFIG.md (게임 값 전체 설명)

# -----------------------------------------------------------------------------
# 1. 서버 기본 설정  (server/.../config/AppConfig.kt)
# -----------------------------------------------------------------------------
# 서버가 열 주소. 0.0.0.0 이면 같은 Wi-Fi 의 다른 기기도 접속 가능, 127.0.0.1 이면 이 PC 만 접속 가능.
PNT_SERVER_HOST=0.0.0.0
# 서버 포트(기본 8080). 숫자가 아니면 조용히 8080 이 된다.
PNT_SERVER_PORT=8080

# -----------------------------------------------------------------------------
# 2. PostgreSQL 연결  (DB 포트 5432 는 인터넷/공유기에 절대 열지 말 것)
# -----------------------------------------------------------------------------
PNT_DB_URL=jdbc:postgresql://localhost:5432/police_thief
PNT_DB_USER=police_thief
# 필수. 없으면 서버가 시작을 거부한다. 아래 change_me 는 자리표시자이니 반드시 직접 정한 비밀번호로 바꾼다.
PNT_DB_PASSWORD=change_me
# DB 연결 풀 크기(기본 10)
# PNT_DB_POOL_SIZE=10

# PostgreSQL 이 없을 때 임시로 쓸 수 있는 H2 파일 DB (선택). 위 DB 3줄(URL/USER/PASSWORD) 대신 아래 3줄을 사용.
# PNT_DB_URL=jdbc:h2:file:./build/devdb/police_thief;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
# PNT_DB_USER=sa
# PNT_DB_PASSWORD=

# -----------------------------------------------------------------------------
# 3. 개발/운영 모드 스위치
# -----------------------------------------------------------------------------
# true: 앱의 개발자 테스트 좌표(source=MOCK)를 허용하고, MOCK 좌표는 과속 판정에서 제외한다.
#       개발/시연 서버에서만 true. 실제 경기 테스트 서버는 false (기본값, MOCK 요청은 403).
PNT_ALLOW_MOCK_LOCATIONS=false
# true: /api/dev/... 개발자 도구(봇 만들기, 서버 시간 앞당기기)를 연다.
#       PNT_ALLOW_MOCK_LOCATIONS=true 도 함께 필요(아니면 서버가 시작을 거부). 실제 경기 서버에서는 반드시 false.
PNT_DEV_TOOLS=false
# 위 두 값은 정확히 true / false (소문자)만 인정한다. 다른 값은 오류 없이 false 로 처리된다.

# 게스트 로그인 토큰 유효 기간(일, 기본 30)
PNT_TOKEN_TTL_DAYS=30
# GET /api/health 응답에 표시되는 서버 버전 문자열(기본 0.2.0)
# PNT_APP_VERSION=0.2.0

# -----------------------------------------------------------------------------
# 4. 게임 임시값 (PROVISIONAL)  (server/.../game/GameSettings.kt)
#    팀이 아직 확정하지 않은 판정 수치다. 아래 줄은 모두 "기본값"을 적어 둔 것이며 '#' 을 지울 때만 적용된다.
#    확정 규칙(4명 2:2, 500m, 10분, 30초, 10m, 30분, 3분, 25km/h, 경고 3회)은 여기서 바꿀 수 없다.
#    시간 값은 정수 "초" 단위(소수점 불가). 형식이 틀리면 서버가 시작을 거부한다.
# -----------------------------------------------------------------------------

# ---- 위치 품질 ----
# 매칭에 쓸 위치의 최대 나이(초). 이보다 오래된 위치는 매칭 요청 거부, 대기자는 후보에서 제외
# PNT_GAME_MATCH_LOCATION_MAX_AGE_SECONDS=60
# 매칭 요청 위치의 GPS 정확도 상한(미터)
# PNT_GAME_MATCH_MAX_ACCURACY_M=100.0
# 구역 이탈·미션 판정에 쓸 위치의 정확도 상한(미터). 더 부정확하면 판정하지 않음
# PNT_GAME_JUDGEMENT_MAX_ACCURACY_M=30.0
# 감옥 자동 수감 판정에 쓸 위치의 정확도 상한(미터)
# PNT_GAME_JAIL_MAX_ACCURACY_M=15.0
# 감옥 판정 위치의 최신성(초). 측정 후 이 시간이 지난 위치는 쓰지 않음
# PNT_GAME_JAIL_SAMPLE_MAX_AGE_SECONDS=30

# ---- 구역 ----
# 연속 구역 이탈 허용 시간(초). 넘으면 실격(경기 무효). 0 이면 실격 판정을 끈다
# PNT_GAME_ZONE_OUT_DISQUALIFY_SECONDS=30
# 구역 축소 일정. 형식: "경기시작후_초:반경_미터" 를 쉼표로 이음. 시간은 커지고 반경은 작아져야 함. 빈 값이면 축소 없음
# 기본값 = 10분 후 400m, 20분 후 300m, 25분 후 200m
# PNT_GAME_ZONE_STAGES=600:400,1200:300,1500:200
# 구역 축소 예고를 몇 초 전에 보낼지
# PNT_GAME_ZONE_WARNING_SECONDS=60

# ---- 도둑 미션 ----
# 경기 시작 후 첫 미션까지(초)
# PNT_GAME_MISSION_FIRST_DELAY_SECONDS=180
# 미션 종료 후 다음 미션까지(초)
# PNT_GAME_MISSION_INTERVAL_SECONDS=300
# 미션 제한 시간(초)
# PNT_GAME_MISSION_DURATION_SECONDS=240
# 미션 구역 반경(미터)
# PNT_GAME_MISSION_RADIUS_M=30.0
# 미션 목표가 감옥(구역 중심)에서 최소 떨어질 거리(미터)
# PNT_GAME_MISSION_MIN_DISTANCE_FROM_JAIL_M=50.0
# 미션 실패 시 다음 구역 축소를 앞당길 시간(초)
# PNT_GAME_MISSION_FAILURE_ADVANCE_SECONDS=120

# ---- 과속 판정 방법 (25km/h, 경고 3회 실격은 확정값이라 여기서 바꿀 수 없음) ----
# 속도 계산에 쓰는 두 위치 표본의 최소 시간 간격(초)
# PNT_GAME_SPEED_MIN_INTERVAL_SECONDS=5
# 속도 계산에 쓸 표본의 정확도 상한(미터)
# PNT_GAME_SPEED_MAX_ACCURACY_M=20.0
# 기준 초과가 연속 몇 번 나와야 경고 1회로 칠지(1 이상)
# PNT_GAME_SPEED_CONSECUTIVE_SAMPLES=2
# 경고와 경고 사이 최소 간격(초)
# PNT_GAME_SPEED_WARNING_COOLDOWN_SECONDS=60
# 이 속도(km/h)보다 빠른 이동은 GPS 순간이동 오류로 보고 판정에서 제외
# PNT_GAME_TELEPORT_SPEED_KMH=150.0

# ---- 선택 기능 ----
# 경찰의 "도둑 폰 울리기" 기능. UI 설계안 아이디어이며 확정된 요구사항이 아님 → 기본 false(꺼짐)
# PNT_FEATURE_RING_THIEF_PHONE=false
# 폰 울리기 쿨다운(초)
# PNT_GAME_RING_COOLDOWN_SECONDS=60

# ---- 운영 ----
# 위치 기록 보관 기간(시간 단위, 정수). 지나면 서버가 삭제한다(기본 24시간)
# PNT_LOCATION_RETENTION_HOURS=24
